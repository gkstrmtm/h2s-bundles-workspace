{
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": ".",
  "public": true,
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/dash",
      "permanent": false
    },
    {
      "source": "/-",
      "destination": "/dash",
      "permanent": false
    },
    {
      "source": "/bundles",
      "has": [
        {
          "type": "host",
          "value": "portal.home2smart.com"
        }
      ],
      "destination": "/dash",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://h2s-backend.vercel.app/api/:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/dash",
      "destination": "/Dash.html"
    },
    {
      "source": "/dash/(.*)",
      "destination": "/Dash.html"
    },
    {
      "source": "/dash.html",
      "destination": "/Dash.html"
    },
    {
      "source": "/Dash.html",
      "destination": "/Dash.html"
    },
    {
      "source": "/Dash",
      "destination": "/Dash.html"
    },
    {
      "source": "/Dash/(.*)",
      "destination": "/Dash.html"
    },
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/bundles",
      "destination": "/bundles.html"
    },
    {
      "source": "/shop",
      "destination": "/bundles.html"
    },
    {
      "source": "/reviews",
      "destination": "https://h2s-backend.vercel.app/reviews.html"
    }
  ],
  "headers": [
    {
      "source": "/Dash.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Vary",
          "value": "Host"
        }
      ]
    },
    {
      "source": "/portal",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        },
        {
          "key": "Vary",
          "value": "Host"
        }
      ]
    },
    {
      "source": "/dash",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Vary",
          "value": "Host"
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Vary",
          "value": "Host"
        }
      ]
    },
    {
      "source": "/-",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Vary",
          "value": "Host"
        }
      ]
    },
    {
      "source": "/bundles.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/bundles.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/funnel-track",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/funnel-track.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ]
}
