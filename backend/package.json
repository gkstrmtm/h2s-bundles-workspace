{
  "name": "h2s-dashboard-backend",
  "version": "1.0.1",
  "description": "Backend for H2S Dashboard",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=6144 next dev",
    "dev:safe": "cross-env NODE_OPTIONS=--max-old-space-size=6144 node start-safe.js dev",
    "dev:port": "cross-env NODE_OPTIONS=--max-old-space-size=6144 next dev -p 3001",
    "postinstall": "npx prisma generate && npm --prefix ../config/pricing ci --ignore-scripts --include=dev && npm run package:forecast",
    "vercel-build": "npm run build",
    "build": "npm run package:forecast && npm run package:portal && cross-env NODE_OPTIONS=--max-old-space-size=6144 npx prisma generate && cross-env NODE_OPTIONS=--max-old-space-size=6144 next build",
    "package:forecast": "node tools/package-forecast-policy.cjs",
    "package:portal": "node tools/package-portal.cjs",
    "test:portal-packaging": "node --test tests/portal_packaging.test.cjs",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=6144 next start",
    "lint": "next lint",
    "test": "node --test tests/task_creator.test.cjs",
    "db:inspect": "node apply_migration_pg.js inspect",
    "db:status": "node apply_migration_pg.js status",
    "db:apply": "node apply_migration_pg.js apply",
    "db:verify": "node apply_migration_pg.js verify"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.86.2",
    "dotenv": "^17.2.3",
    "jose": "^6.1.3",
    "next": "14.2.18",
    "node-fetch": "^3.3.2",
    "openai": "^4.20.1",
    "pg": "^8.19.0",
    "prisma": "^5.22.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "stripe": "^20.1.0",
    "twilio": "^5.11.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "typescript": "^5.3.3"
  }
}
