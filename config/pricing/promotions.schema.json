{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://home2smart.com/schemas/pricing-experiments-v1.json",
  "title": "Offline promotion comparisons, never automatic activation",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "baselineVersion", "currency", "offers"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "baselineVersion": {"type": "string", "minLength": 1},
    "currency": {"const": "USD"},
    "offers": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "discount", "eligibility"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "status": {"const": "proposed_not_active"},
          "eligibility": {"type": "null"},
          "sourceField": {"type": "string", "minLength": 1},
          "discount": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false, "required": ["type", "amount"],
                "properties": {"type": {"const": "fixed_amount"}, "amount": {"type": "number", "exclusiveMinimum": 0, "multipleOf": 0.01}}
              },
              {
                "type": "object", "additionalProperties": false, "required": ["type", "percent"],
                "properties": {"type": {"const": "percentage"}, "percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100, "multipleOf": 0.01}}
              }
            ]
          }
        }
      }
    }
  }
}
